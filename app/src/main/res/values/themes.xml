<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IPCDemo" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/ipc_primary</item>
        <item name="colorPrimaryVariant">@color/ipc_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ipc_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/ipc_header</item>
        <item name="android:navigationBarColor">@color/ipc_bg</item>
        <item name="android:windowBackground">@color/ipc_bg</item>
        <item name="colorControlActivated">@color/ipc_primary</item>
        <item name="textInputStyle">@style/Widget.IPCDemo.TextInput</item>
    </style>

    <style name="Widget.IPCDemo.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/ipc_input_stroke</item>
        <item name="hintTextColor">@color/ipc_primary</item>
        <item name="boxCornerRadiusTopStart">6dp</item>
        <item name="boxCornerRadiusTopEnd">6dp</item>
        <item name="boxCornerRadiusBottomStart">6dp</item>
        <item name="boxCornerRadiusBottomEnd">6dp</item>
    </style>

    <style name="Widget.IPCDemo.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/ipc_primary</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.IPCDemo.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ipc_primary</item>
        <item name="strokeColor">@color/ipc_primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="rippleColor">@color/ipc_primary</item>
    </style>

    <style name="Widget.IPCDemo.Button.Ghost" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ipc_danger</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <!-- Compact preview control chip -->
    <style name="Widget.IPCDemo.Button.Quick" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ipc_ink</item>
        <item name="android:textSize">12sp</item>
        <item name="strokeColor">@color/ipc_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/ipc_primary</item>
    </style>

    <style name="Widget.IPCDemo.Button.QuickPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">@color/ipc_primary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.IPCDemo.Button.Feature" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ipc_ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
        <item name="backgroundTint">@color/ipc_surface</item>
        <item name="strokeColor">@color/ipc_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/ipc_primary</item>
    </style>

    <style name="Widget.IPCDemo.Button.FsChip" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="strokeColor">#66FFFFFF</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">#33FFFFFF</item>
    </style>

    <style name="TextAppearance.IPCDemo.HeaderTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ipc_header_text</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="TextAppearance.IPCDemo.Brand" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ipc_ink</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.IPCDemo.Subtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ipc_ink_secondary</item>
    </style>

    <style name="TextAppearance.IPCDemo.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ipc_ink_muted</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
