<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ipc_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="36dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_accent_bar" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/brand_name"
                android:textAppearance="@style/TextAppearance.IPCDemo.HeaderTitle"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/main_subtitle"
                android:textColor="@color/ipc_ink_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_home"
                android:textAppearance="@style/TextAppearance.IPCDemo.Label" />

            <TextView
                android:id="@+id/tvCurrentHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/no_current_home"
                android:textColor="@color/ipc_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@color/ipc_border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_list"
                android:textAppearance="@style/TextAppearance.IPCDemo.Label" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:minLines="3"
                android:text="@string/home_list_empty"
                android:textColor="@color/ipc_ink_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/section_actions"
                android:textAppearance="@style/TextAppearance.IPCDemo.Label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateHome"
                style="@style/Widget.IPCDemo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/create_home" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHomeList"
                style="@style/Widget.IPCDemo.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/home_list_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefreshHomes"
                style="@style/Widget.IPCDemo.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/refresh_homes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEzConfig"
                style="@style/Widget.IPCDemo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/ipc_header"
                android:text="@string/ez_config" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApConfig"
                style="@style/Widget.IPCDemo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/ipc_header"
                android:text="@string/ap_config" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQrConfig"
                style="@style/Widget.IPCDemo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/ipc_header"
                android:text="@string/qr_config" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeviceList"
                style="@style/Widget.IPCDemo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/device_list_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.IPCDemo.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/logout" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
