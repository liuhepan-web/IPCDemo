<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#E8F1F5" />
            <stroke
                android:width="1dp"
                android:color="@color/ipc_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ipc_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/ipc_border" />
        </shape>
    </item>
</selector>
