<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name="com.ipc.demo.set.IpcDemoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ipc_app_icon"
        android:label="@string/ipc_demo_app_name"
        android:roundIcon="@mipmap/ipc_app_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IPCDemo"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:allowBackup,android:supportsRtl,android:label,android:icon,android:roundIcon"
        tools:targetApi="31">

        <meta-data
            android:name="THING_SMART_APPKEY"
            android:value="${TUYA_SMART_APPKEY}" />
        <meta-data
            android:name="THING_SMART_SECRET"
            android:value="${TUYA_SMART_SECRET}" />

        <activity
            android:name="com.ipc.demo.set.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.ipc.demo.set.RegisterActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.ipc.demo.set.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.ipc.demo.set.CreateHomeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.ipc.demo.set.DeviceConfigEzActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.ipc.demo.set.DeviceConfigApActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.ipc.demo.set.DeviceConfigQrActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.ipc.demo.set.HomeListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.ipc.demo.set.DeviceListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.ipc.demo.set.CameraPanelActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.ipc.demo.set.CameraSdManageActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.ipc.demo.set.CameraMessageActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.ipc.demo.set.CameraMessageImageActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.ipc.demo.set.CameraAlbumActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.ipc.demo.set.CameraAlbumPreviewActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.ipc.demo.set.CameraVideoMessageActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.ipc.demo.set.CameraPlaybackActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.ipc.demo.set.CameraCloudStorageActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.ipc.demo.set.CameraDoorBellActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:taskAffinity="" />
    </application>

</manifest>
